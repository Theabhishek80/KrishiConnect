# Copy this file to ".env" (same folder) and fill in the values.
# ".env" is git-ignored. Real environment variables on Railway/Render override it.

DATABASE_URL=jdbc:postgresql://localhost:5432/krishiconnect
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
# Comma-separated list of allowed website origins (CORS)
FRONTEND_URL=http://localhost:5173

MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_FROM=noreply@krishiconnect.local

ADMIN_EMAIL=admin@krishiconnect.local
ADMIN_PASSWORD=change-this-admin-password

# --- KisanDirect AI (Google Gemini) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# --- Firebase Admin: REQUIRED for login / register / Google sign-in ---
# Use ONE of these two:
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_FILE=

# --- ImageKit (image uploads) ---
IMAGEKIT_PRIVATE_KEY=
