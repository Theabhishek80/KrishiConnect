
{
  "rewrites": [
    {
      "source": "/api/admin/:route*",
      "destination": "/api/admin-proxy?route=:route*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://YOUR-RAILWAY-BACKEND-DOMAIN/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}

