
{
  "rewrites": [
    {
      "source": "/api/admin/:route*",
      "destination": "/api/admin-proxy?route=:route*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://krishiconnect-production-a757.up.railway.app/api/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}


